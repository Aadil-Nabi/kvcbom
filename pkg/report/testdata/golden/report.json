    {
      "id": "migrate-asymmetric-to-pqc",
      "summary": "Replace Shor-vulnerable public-key cryptography with NIST post-quantum standards.",
      "detail": "Plan migration of key establishment to ML-KEM (FIPS 203) and signatures to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205), prioritising systems that protect long-lived data or perform key establishment over untrusted networks. Hybrid (classical + PQC) deployment is a common transitional step.\n",
      "references": [
        "fips-203",
        "fips-204",
        "fips-205",
        "nist-ir-8547"
      ],
      "finding_types": [
        "quantum-vulnerable-key-establishment"
      ],
      "finding_count": 1,
      "top_severity": "critical"
    },
    {
      "id": "replace-broken-primitive",
      "summary": "Replace algorithms already broken or disallowed by classical cryptanalysis.",
      "detail": "Retire MD5, SHA-1, single/triple DES, and RC4 in favour of current algorithms such as SHA-256/SHA-3 for hashing and AES-256 for symmetric encryption.\n",
      "references": [
        "sp-800-131a"
      ],
